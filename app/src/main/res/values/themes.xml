<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 基础主题：深色为主。使用 Android 框架自带主题，避免依赖 Material Components XML 主题；
         Compose 的 Material3 仅提供 Compose 组件，不提供 XML 主题。 -->
    <style name="Theme.PocketCodeStudio" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/pcs_bg</item>
        <item name="android:navigationBarColor">@color/pcs_bg</item>
        <item name="android:windowBackground">@color/pcs_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>